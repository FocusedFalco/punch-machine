# Backend (server/) env vars -- set these on Render (or wherever the
# server/ process runs). See client/.env.example for the frontend's own var.

PORT=8080
ADMIN_CODE=                                 # the one shared admin login code
HMAC_SECRET=                                # used to hash team access codes -- keep stable across restarts
TOTAL_OUT_MS=25200000                       # 7 hours, in milliseconds

# Supabase (or any Postgres) connection string. Use Supabase's "Session
# pooler" connection string (port 5432), not the "Transaction pooler"
# (port 6543) -- this is one persistent long-lived process, not serverless.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Pin CORS to your actual Vercel URL in production; omit to allow any origin.
CLIENT_ORIGIN=https://outtime.vercel.app
